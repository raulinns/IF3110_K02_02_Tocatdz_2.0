APP_ENV=development
HTTP_ADDR=:8080
# Origin persis yang dibuka di browser (cek Origin/CSRF). Production wajib https.
PUBLIC_ORIGIN=http://localhost:8080
DATABASE_URL=postgres://app:app@localhost:5433/platform?sslmode=disable

# Isi dengan output `go run ./cmd/keygen` (dari folder src). Tiga kunci harus berbeda dan jangan di-commit.
SESSION_ENCRYPTION_KEY=
CSRF_HMAC_KEY=
CONNECTION_ENCRYPTION_KEY=

# Hanya untuk `go run ./cmd/seed` (akun dan database demo). Password minimal 15 karakter.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_VIEWER_PASSWORD=
SEED_TARGET_NAME=demo
SEED_TARGET_DATABASE_URL=postgres://app:app@localhost:5433/demo?sslmode=disable

# Opsional: server PostgreSQL khusus test integration (test membuat dan menghapus database sendiri).
# TEST_DATABASE_URL=postgres://app:app@localhost:5433/postgres?sslmode=disable
