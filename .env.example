APP_ENV=development
HTTP_ADDR=:8080
# Origin persis yang dibuka di browser (cek Origin/CSRF). Production wajib https.
PUBLIC_ORIGIN=http://localhost:8080
# Alamat database memakai 127.0.0.1, bukan localhost: di Windows, localhost bisa ±5 kali lebih lambat karena mencoba IPv6 lebih dulu.
DATABASE_URL=postgres://app:app@127.0.0.1:5433/platform?sslmode=disable

# Isi dengan output `go run ./cmd/keygen` (dari folder src). Tiga kunci harus berbeda dan jangan di-commit.
SESSION_ENCRYPTION_KEY=
CSRF_HMAC_KEY=
CONNECTION_ENCRYPTION_KEY=

# Hanya untuk `go run ./cmd/seed` (akun dan database demo). Password minimal 15 karakter.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_VIEWER_PASSWORD=
# Editor mengajukan perubahan; admin dan pengamat menjadi leader yang menyetujui.
SEED_EDITOR_PASSWORD=
# Opsional: password untuk akun yang passwordnya kosong. Untuk stress test k6 isi sama dengan K6_PASSWORD.
# SEED_SHARED_PASSWORD=
# DSN target yang disimpan seed dipakai oleh server. Jika server dan worker berjalan di Docker, seed harus memakai
# host `postgres` (nama service compose), misalnya postgres://app:app@postgres:5432/demo, bukan 127.0.0.1.
SEED_TARGET_NAME=demo
SEED_TARGET_DATABASE_URL=postgres://app:app@127.0.0.1:5433/demo?sslmode=disable
SEED_TARGET2_NAME=gudang
SEED_TARGET2_DATABASE_URL=postgres://app:app@127.0.0.1:5433/gudang?sslmode=disable

# Worker migration. EMBEDDED_WORKER=true menjalankan worker di dalam proses server (pengembangan lokal).
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=2
# WORKER_ID=worker-1

# Alamat listener Prometheus (/metrics) untuk server dan worker; kosong berarti dimatikan.
METRICS_ADDR=
# Kirim trace ke OTel Collector lewat OTLP/HTTP (span selalu dicetak ke stdout). Contoh di Docker:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Tracing JSON ke stdout selalu aktif. Opsional: tambahkan exporter OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Endpoint khusus trace mencakup path /v1/traces dan mengungguli endpoint umum.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Opsional, hanya saat setup database target tambahan dengan cmd/target-init.
# Akun pemilik/superuser dipakai saat setup; masukkan DSN akun hasil setup ke UI admin.
# TARGET_ADMIN_DATABASE_URL=postgres://app:app@127.0.0.1:5433/target_lain?sslmode=disable

# Opsional: server PostgreSQL khusus test integration (test membuat dan menghapus database sendiri).
# TEST_DATABASE_URL=postgres://app:app@127.0.0.1:5433/postgres?sslmode=disable
